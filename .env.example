PORT=4000
MONGODB_URI=mongodb://localhost:27017/finatech
CLIENT_URL=http://localhost:4000
SMTP_FROM_NAME="FinaTech"
SMTP_FROM_EMAIL="no-reply@finatech.local"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_USE_POOL=false
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_IGNORE_TLS_ERRORS=false
SMTP_FORCE_IPV4=false
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
AUTH_RATE_LIMIT_MAX=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
TWO_FACTOR_CHALLENGE_DURATION_MINUTES=5
SESSION_MAX_AGE_MS=86400000
SESSION_REMEMBER_MAX_AGE_MS=2592000000
PASSWORD_RESET_WINDOW_MINUTES=30
AUTH_REQUIRE_EMAIL_VERIFICATION=false
ADMIN_EMAILS=
CSRF_PROTECTION_ENABLED=true

# SMTP performance tuning
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_SOCKET_TIMEOUT_MS=20000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES=50
SMTP_RETRY_ATTEMPTS=2
SMTP_RETRY_BACKOFF_MS=1500
SMTP_DEBUG_LOGS=false

# MongoDB connection tuning
DB_SERVER_SELECTION_TIMEOUT_MS=5000
DB_MAX_POOL_SIZE=20
DB_CONNECT_TIMEOUT_MS=5000
DB_SOCKET_TIMEOUT_MS=20000

# LocationIQ
LOCATIONIQ_API_KEY=your-locationiq-api-key
LOCATIONIQ_TILE_API_KEY=your-locationiq-tiles-key
LOCATIONIQ_COUNTRY_CODES=ar
LOCATIONIQ_BASE_TILES_URL=https://{s}.locationiq.com/v3/streets/r/{z}/{x}/{y}.png

# Treasury balance thresholds (optional alerts; set numeric values to enable)
TREASURY_THRESHOLD_TRANSFERS_MIN=
TREASURY_THRESHOLD_TRANSFERS_MAX=
TREASURY_THRESHOLD_CASH_MIN=
TREASURY_THRESHOLD_CASH_MAX=
TREASURY_THRESHOLD_USD_MIN=
TREASURY_THRESHOLD_USD_MAX=
TREASURY_THRESHOLD_COURIER_MIN=
TREASURY_THRESHOLD_COURIER_MAX=
